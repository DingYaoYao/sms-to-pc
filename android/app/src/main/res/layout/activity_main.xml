<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- 标题 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="码上来"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="手机收到短信，电脑上直接看"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 配对卡：只需要输入配对码 -->
        <LinearLayout
            android:id="@+id/card_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pair_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/pair_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="正在自动搜索电脑…"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="在电脑上打开“码上来”"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="把电脑上显示的 4 位配对码填到下面"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:digits="0123456789"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="0000"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="4"
                android:maxLines="1"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:textColor="@color/text"
                android:textColorHint="#B9BDC9"
                android:textSize="30sp" />

            <Button
                android:id="@+id/button_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:stateListAnimator="@null"
                android:text="连接电脑"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/manual_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:padding="10dp"
                android:text="搜不到电脑？手动填地址"
                android:textColor="@color/brand"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/manual_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/input_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="例如 192.168.1.7 或 192.168.1.7:8789"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="#B9BDC9"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/button_connect_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_ghost"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:stateListAnimator="@null"
                    android:text="用这个地址连接"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 已连接卡 -->
        <LinearLayout
            android:id="@+id/card_connected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/connected_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="已连接到电脑"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/connected_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="手机收到新短信会自动出现在电脑上"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="已转发 0 条"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/button_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_ghost"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:text="发送一条测试消息"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_unpair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_ghost"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:text="解除配对"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 权限卡 -->
        <LinearLayout
            android:id="@+id/card_perms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用前检查"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/perm_sms_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:id="@+id/perm_sms_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="短信权限"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="没有它就收不到任何短信"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/perm_sms_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去开启 ›"
                    android:textColor="@color/warn"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/perm_bg_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:id="@+id/perm_bg_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="后台运行"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="锁屏后不被省电模式限制"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/perm_bg_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去开启 ›"
                    android:textColor="@color/warn"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/autostart_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="10dp"
                android:text="小米等系统还可以允许“自启动”，点这里设置（可选）"
                android:textColor="@color/brand"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="短信只在你自己的手机和电脑之间传输\n不经过任何服务器"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/button_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="14dp"
            android:text="关于"
            android:textColor="@color/brand"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
